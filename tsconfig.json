{
  "extends": "@cteic/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["*.js", "packages/*-config/**/*.js", "packages/*-config/**/*.ts"],
  "exclude": ["**/node_modules", "packages/*-config/fixtures"]
}
